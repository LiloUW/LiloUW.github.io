# Local preview build only (GitHub Pages ignores this file and builds the live site itself).
# Pins github-pages 227 and a few dependencies so the build runs on the older system Ruby (2.6) on
# macOS; newer Rubies can use the root Gemfile instead. Used by _scripts/build.sh.
source "https://rubygems.org"
gem "github-pages", "227", group: :jekyll_plugins
gem "ffi", "< 1.17"
gem "nokogiri", "< 1.14"
gem "public_suffix", "< 5"
gem "activesupport", "< 7"
gem "zeitwerk", "< 2.7"
gem "concurrent-ruby", "< 1.3.5"
gem "webrick"
